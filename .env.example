# Copie para .env e preencha a chave. O arquivo .env fica fora do git.
# Gere uma chave com:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Use False no site publicado.
DJANGO_DEBUG=True

# Hosts aceitos, sem espacos. Exemplo: localhost,meusite.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Site publicado: True se um proxy da hospedagem cuidar do HTTPS.
DJANGO_BEHIND_PROXY=False

# Validade do HSTS em segundos. Aumente aos poucos depois de confirmar o HTTPS.
DJANGO_HSTS_SECONDS=3600

# Endereco do frontend, usado nos links enviados por e-mail.
DJANGO_FRONTEND_URL=http://localhost:5173

# Envio de e-mail. Sem senha, em desenvolvimento o e-mail aparece no terminal do backend.
# No Gmail, use uma senha de app: https://myaccount.google.com/apppasswords
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
